# =============================================================================
# Multi-environment API URLs
# =============================================================================
# - next dev          → uses .env.development (local backend)
# - next build/start  → uses .env.production (Vazivo production)
# - To use staging API locally: copy .env.staging to .env.local
# =============================================================================

# Development (local backend)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Production (Vazivo)
# NEXT_PUBLIC_API_URL=https://api.vazivo.com/api/v1
# API_URL=https://api.vazivo.com/api/v1

# App
NEXT_PUBLIC_APP_NAME=Vazivo
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_CURRENCY=MAD
NEXT_PUBLIC_CURRENCY_LOCALE=fr-MA

# Sentry (optional). Override DSN; if unset, default DSN is used.
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Optional
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_key_here
